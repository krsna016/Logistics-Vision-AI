# Required in every deployed environment. Use a random value of at least 32 characters.
SECRET_KEY=replace-with-a-random-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Precise location pings older than this are permanently removed.
LOCATION_RETENTION_DAYS=30
# Optional one-time bootstrap password. Leave empty after the first admin is created.
BOOTSTRAP_ADMIN_PASSWORD=
# Set true only for a one-time admin password recovery, then turn it off.
RESET_ADMIN_PASSWORD=false
ADMIN_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=anurags-workspace-hfvt2
ROBOFLOW_WORKFLOW_ID=general-segmentation-api
ROBOFLOW_CLASSES=Cardboxes,Carton
ROBOFLOW_API_URL=https://serverless.roboflow.com
